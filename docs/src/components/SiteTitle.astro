---
/** @fileoverview Renders the Fabrica Assemble mark and baseline-aligned brand links in both themes. */
---
<div class="inline-flex gap-2 items-baseline text-ink no-underline text-[1.05rem] font-[650] tracking-[-.04em] whitespace-nowrap max-md:text-base [&_a]:inline-flex [&_a]:items-center [&_a]:min-h-11 [&_a]:no-underline" aria-label="Fabrica / Release Planner">
  <a class="relative gap-[.4rem] pl-[19px] text-(--sl-color-gray-3) text-[.85em] font-normal hover:text-ink" href="https://fabricahq.com">
    <svg class="absolute left-0 top-1/2 -translate-y-1/2 size-4 overflow-visible" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 1.75 21.25 7.1V17L12 22.35 2.75 17V7.1Z" />
        <path d="m2.75 7.1 9.25 5.35 9.25-5.35M12 12.45v9.9" />
        <path d="m7.375 4.425 9.25 5.35M7.375 9.775v9.9M12 17.4l9.25-5.35" />
      </g>
    </svg>
    <span>Fabrica</span>
  </a>
  <span class="text-muted font-normal" aria-hidden="true">/</span>
  <a class="text-inherit hover:text-black dark:hover:text-white" href="/" aria-label="Release Planner docs">Release Planner</a>
</div>
