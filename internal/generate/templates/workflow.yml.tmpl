{{- define "install"}}
{{- if .IsRelease}}
      - name: Install Release Planner {{.Version}}
        env:
          GH_TOKEN: ${{"{{"}} github.token {{"}}"}}
        # Verify the build attestation of the checksum manifest, then the archive against it.
        run: |
          dir="$RUNNER_TEMP/release-planner"
          mkdir -p "$dir" && cd "$dir"
          archive="release-planner_${RELEASE_PLANNER_VERSION#v}_linux_amd64.tar.gz"
          gh release download "$RELEASE_PLANNER_VERSION" --repo fabricahq/release-planner --pattern SHA256SUMS --pattern "$archive"
          gh attestation verify SHA256SUMS --repo fabricahq/release-planner
          sha256sum --check --ignore-missing SHA256SUMS
          tar -xzf "$archive" release-planner
          echo "$dir" >> "$GITHUB_PATH"
{{- else}}
      - uses: {{.Actions.SetupGo}}
        with:
          go-version: stable
          cache: false
      - name: Install Release Planner at commit {{.Version}}
        run: |
          go install "{{.Module}}@$RELEASE_PLANNER_VERSION"
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"
{{- end}}
{{- end -}}
name: Release
# Notes changes in a PR are validated; a notes change on {{.Branch}} approves publication,
# so ordinary changes never create releases.
on:
  push:
    branches: [{{yamlString .Branch}}]
    paths: [{{yamlString (printf "%s/v*.md" .NotesDir)}}]
  pull_request:
    paths: [{{yamlString (printf "%s/**" .NotesDir)}}, '.release-planner/**', '.github/workflows/release-planner.yml']
  # Retry a failed publication with both endpoints of the original approved push.
  workflow_dispatch:
    inputs:
      commit:
        description: 'Approved head SHA from the original failed run summary'
        required: true
        type: string
      base:
        description: 'Base SHA from the original failed run summary'
        required: true
        type: string
permissions:
  contents: read
env:
  RELEASE_PLANNER_VERSION: {{.Version}}
jobs:
  # Check the generated files, then validate the notes change and bind it to one version and
  # commit. Release notes rules that the notes break are warnings, not failures.
  validate:
    if: github.event_name != 'workflow_dispatch' || github.ref == 'refs/heads/{{.Branch}}'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read # to check the release environment's settings
    outputs:
      tag: ${{"{{"}} steps.validate.outputs.tag {{"}}"}}
{{- if .ReleaseAssets.Enabled}}
      version: ${{"{{"}} steps.validate.outputs.version {{"}}"}}
{{- end}}
      commit: ${{"{{"}} steps.validate.outputs.commit {{"}}"}}
    steps:
      - uses: {{.Actions.Checkout}}
        with:
          # Version ordering and retries need the full history and tags.
          fetch-depth: 0
          ref: ${{"{{"}} inputs.commit || github.event.pull_request.head.sha || github.sha {{"}}"}}
          persist-credentials: false
{{- template "install" .}}
      - name: Check the generated release files
        run: release-planner check
      - name: Validate the release request
        id: validate
        env:
          EVENT: ${{"{{"}} github.event_name {{"}}"}}
          BASE: ${{"{{"}} inputs.base || github.event.pull_request.base.sha || github.event.before {{"}}"}}
          HEAD: ${{"{{"}} inputs.commit || github.event.pull_request.head.sha || github.sha {{"}}"}}
          GITHUB_TOKEN: ${{"{{"}} github.token {{"}}"}}
        run: release-planner validate --ci --event "$EVENT" --base "$BASE" --head "$HEAD" --out "$RUNNER_TEMP/release-plan.json"
      - uses: {{.Actions.UploadArtifact}}
        with:
          name: release-plan
          path: ${{"{{"}} runner.temp {{"}}"}}/release-plan.json
          if-no-files-found: error
{{if .ReleaseChecks.Workflow}}
  # Run this repository's release-only checks on the exact commit being released.
  # The called workflow gets the repository's secrets, but never the release-write token.
  release-checks:
    needs: validate
    if: needs.validate.outputs.tag != ''
    uses: ./.github/workflows/{{.ReleaseChecks.Workflow}}
    with:
      ref: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
    secrets: inherit
{{else if .ReleaseChecks.Run}}
  # Run this repository's release-only checks on the exact commit being released.
  release-checks:
    needs: validate
    if: needs.validate.outputs.tag != ''
    runs-on: ubuntu-latest
    steps:
      - uses: {{.Actions.Checkout}}
        with:
          ref: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
          persist-credentials: false
{{- if .ReleaseChecks.Go}}
      - uses: {{.Actions.SetupGo}}
        with:
          go-version: '{{.ReleaseChecks.Go}}'
{{- end}}
{{- if .ReleaseChecks.Node}}
      - uses: {{.Actions.SetupNode}}
        with:
          node-version: '{{.ReleaseChecks.Node}}'
{{- end}}
{{- if .ReleaseChecks.Python}}
      - uses: {{.Actions.SetupPython}}
        with:
          python-version: '{{.ReleaseChecks.Python}}'
{{- end}}
      - name: Run the release checks
        run: |
{{.ReleaseChecksRun}}
{{end}}
{{- if .ReleaseAssets.Enabled}}
  # Build the files to attach on the exact commit being released. The called workflow uploads
  # them as the release-assets artifact, with read access and none of the repository's secrets.
  release-assets:
    needs: {{if .ReleaseChecks.Enabled}}[validate, release-checks]{{else}}validate{{end}}
    if: needs.validate.outputs.tag != '' && github.event_name != 'pull_request' && github.ref == 'refs/heads/{{.Branch}}'
    permissions:
      contents: read
    uses: ./.github/workflows/{{.ReleaseAssets.Workflow}}
    with:
      ref: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
      tag: ${{"{{"}} needs.validate.outputs.tag {{"}}"}}
      version: ${{"{{"}} needs.validate.outputs.version {{"}}"}}

  # Attest the release assets, so users can verify they came from this workflow.
  # This job checks out no source and cannot write to the repository.
  attest:
    needs: [validate, release-assets]
    if: needs.validate.outputs.tag != '' && github.event_name != 'pull_request' && github.ref == 'refs/heads/{{.Branch}}'
    runs-on: ubuntu-latest
    environment: release
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - uses: {{.Actions.DownloadArtifact}}
        with:
          name: release-assets
          path: ${{"{{"}} runner.temp {{"}}"}}/release-assets
      - uses: {{.Actions.AttestBuildProvenance}}
        with:
          subject-path: ${{"{{"}} runner.temp {{"}}"}}/release-assets/*
{{end}}
  # The only job that can write. It runs the pinned Release Planner version and no repository code.{{if .ReleaseAssets.Enabled}}
  # It stages the attested assets on a draft, verifies them, and publishes last.{{end}}
  publish:
    needs: [validate{{if .ReleaseChecks.Enabled}}, release-checks{{end}}{{if .ReleaseAssets.Enabled}}, release-assets, attest{{end}}]
    if: needs.validate.outputs.tag != '' && github.event_name != 'pull_request' && github.ref == 'refs/heads/{{.Branch}}'
    runs-on: ubuntu-latest
    environment: release
    permissions:
      contents: write
      pull-requests: read # to confirm the commit is a merged pull request
    # Serialize publication so competing releases cannot race.
    concurrency:
      group: release-publication
      cancel-in-progress: false
    steps:
{{- template "install" .}}
      - uses: {{.Actions.DownloadArtifact}}
        with:
          name: release-plan
          path: ${{"{{"}} runner.temp {{"}}"}}/plan
{{- if .ReleaseAssets.Enabled}}
      - uses: {{.Actions.DownloadArtifact}}
        with:
          name: release-assets
          path: ${{"{{"}} runner.temp {{"}}"}}/release-assets
{{- end}}
      - name: Tag the approved commit and publish the approved notes{{if .ReleaseAssets.Enabled}} and assets{{end}}
        env:
          GITHUB_TOKEN: ${{"{{"}} github.token {{"}}"}}
          COMMIT: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
        run: release-planner publish --plan "$RUNNER_TEMP/plan/release-plan.json" --commit "$COMMIT" --branch {{.Branch}}{{if .ReleaseAssets.Enabled}} --assets "$RUNNER_TEMP/release-assets"{{end}}
