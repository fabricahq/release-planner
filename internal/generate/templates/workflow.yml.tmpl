{{- define "install"}}
{{- if .IsRelease}}
      - name: Install Release Planner {{.Version}}
        env:
          GH_TOKEN: ${{"{{"}} github.token {{"}}"}}
        # Verify the build attestation of the checksum manifest, then the archive against it.
        run: |
          dir="$RUNNER_TEMP/release-planner"
          mkdir -p "$dir" && cd "$dir"
          archive="release-planner_${RELEASE_PLANNER_VERSION#v}_linux_amd64.tar.gz"
          gh release download "$RELEASE_PLANNER_VERSION" --repo fabricahq/release-planner --pattern SHA256SUMS --pattern "$archive"
          gh attestation verify SHA256SUMS --repo fabricahq/release-planner
          sha256sum --check --ignore-missing SHA256SUMS
          tar -xzf "$archive" release-planner
          echo "$dir" >> "$GITHUB_PATH"
{{- else}}
      - uses: {{.Actions.SetupGo}}
        with:
          go-version: stable
          cache: false
      - name: Install Release Planner at commit {{.Version}}
        run: |
          go install "{{.Module}}@$RELEASE_PLANNER_VERSION"
          echo "$(go env GOPATH)/bin" >> "$GITHUB_PATH"
{{- end}}
{{- end -}}
name: Release
# A pull request that adds or edits release notes is validated, checked, and built before it
# merges, and blocks at the start and end of its description report the release's status. Merging it
# into {{.Branch}} approves publication, so ordinary changes never create releases.
on:
  push:
    branches: [{{yamlString .Branch}}]
    paths: [{{yamlString (printf "%s/v*.md" .NotesDir)}}]
  pull_request:
    paths: [{{yamlString (printf "%s/**" .NotesDir)}}, '.release-planner/**', '.github/workflows/release-planner.yml']
  # Retry a failed publication by naming the commit the release pull request merged as.
  workflow_dispatch:
    inputs:
      merged-commit:
        description: 'Full SHA of the commit the release pull request merged as on {{.Branch}}'
        required: true
        type: string
permissions:
  contents: read
env:
  RELEASE_PLANNER_VERSION: {{.Version}}
jobs:
  # Check the generated files, then validate the release pull request and bind it to one
  # release commit: the newest commit the pull request shares with {{.Branch}}. Release notes
  # rules that the notes break are warnings, not failures. After the merge, it also finds the
  # pull request's run, whose checks and assets the release reuses.
  validate:
    if: github.event_name != 'workflow_dispatch' || github.ref == 'refs/heads/{{.Branch}}'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read # to check the environments' settings and find the pull request's run
      pull-requests: read # to find the merged pull request
    outputs:
      tag: ${{"{{"}} steps.validate.outputs.tag {{"}}"}}
      version: ${{"{{"}} steps.validate.outputs.version {{"}}"}}
      commit: ${{"{{"}} steps.validate.outputs.commit {{"}}"}}
      publish: ${{"{{"}} steps.validate.outputs.publish {{"}}"}}
      build: ${{"{{"}} steps.validate.outputs.build {{"}}"}}
      build-run: ${{"{{"}} steps.validate.outputs.build-run {{"}}"}}
    steps:
      - uses: {{.Actions.Checkout}}
        with:
          # Version ordering and the release commit need the full history and tags.
          fetch-depth: 0
          ref: ${{"{{"}} github.event.pull_request.head.sha || inputs.merged-commit || github.sha {{"}}"}}
          persist-credentials: false
{{- template "install" .}}
      - name: Check the generated release files
        run: release-planner check
      - name: Validate the release pull request
        id: validate
        env:
          GITHUB_TOKEN: ${{"{{"}} github.token {{"}}"}}
          BASE: ${{"{{"}} github.event.pull_request.base.sha {{"}}"}}
          HEAD: ${{"{{"}} github.event.pull_request.head.sha {{"}}"}}
          HEAD_REPOSITORY: ${{"{{"}} github.event.pull_request.head.repo.full_name {{"}}"}}
          MERGED: ${{"{{"}} inputs.merged-commit || github.sha {{"}}"}}
        run: |
          if [ -n "$HEAD" ]; then
            release-planner validate --ci --base "$BASE" --head "$HEAD" --head-repository "$HEAD_REPOSITORY" --out "$RUNNER_TEMP/release-plan.json"
          else
            release-planner validate --ci --merged "$MERGED" --out "$RUNNER_TEMP/release-plan.json"
          fi
      - uses: {{.Actions.UploadArtifact}}
        with:
          name: release-plan
          path: ${{"{{"}} runner.temp {{"}}"}}/release-plan.json
          if-no-files-found: error
{{if .ReleaseChecks.Workflow}}
  # Run this repository's release-only checks on the release commit: on the pull request, or
  # after the merge if the pull request's run can't be reused. The called workflow gets the
  # repository's secrets, but never the release-write token.
  release-checks:
    needs: validate
    if: needs.validate.outputs.build == 'true'
    uses: ./.github/workflows/{{.ReleaseChecks.Workflow}}
    with:
      ref: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
    secrets: inherit
{{else if .ReleaseChecks.Run}}
  # Run this repository's release-only checks on the release commit: on the pull request, or
  # after the merge if the pull request's run can't be reused.
  release-checks:
    needs: validate
    if: needs.validate.outputs.build == 'true'
    runs-on: ubuntu-latest
    steps:
      - uses: {{.Actions.Checkout}}
        with:
          ref: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
          persist-credentials: false
{{- if .ReleaseChecks.Go}}
      - uses: {{.Actions.SetupGo}}
        with:
          go-version: '{{.ReleaseChecks.Go}}'
{{- end}}
{{- if .ReleaseChecks.Node}}
      - uses: {{.Actions.SetupNode}}
        with:
          node-version: '{{.ReleaseChecks.Node}}'
{{- end}}
{{- if .ReleaseChecks.Python}}
      - uses: {{.Actions.SetupPython}}
        with:
          python-version: '{{.ReleaseChecks.Python}}'
{{- end}}
      - name: Run the release checks
        run: |
{{.ReleaseChecksRun}}
{{end}}
{{- if .ReleaseAssets.Workflow}}
  # Build the release assets from the release commit, with read-only access and no secrets.
  # The called workflow uploads them as one artifact named release-assets.
  release-assets:
    needs: validate
    if: needs.validate.outputs.build == 'true'
    permissions:
      contents: read
    uses: ./.github/workflows/{{.ReleaseAssets.Workflow}}
    with:
      ref: ${{"{{"}} needs.validate.outputs.commit {{"}}"}}
      tag: ${{"{{"}} needs.validate.outputs.tag {{"}}"}}
      version: ${{"{{"}} needs.validate.outputs.version {{"}}"}}

  # Attest each asset's build provenance, so publish can check the files came from this
  # workflow. This job runs no repository code.
  attest:
    needs: [validate, release-assets]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - uses: {{.Actions.DownloadArtifact}}
        with:
          name: release-assets
          path: ${{"{{"}} runner.temp {{"}}"}}/release-assets
      - uses: {{.Actions.AttestBuildProvenance}}
        with:
          subject-path: '${{"{{"}} runner.temp {{"}}"}}/release-assets/*'
{{end}}
  # The only job that can write, and only after the merge. It runs the pinned Release Planner
  # version and no repository code. It tags the release commit and publishes the approved
  # notes, or replaces the notes of published releases.
{{- if .ReleaseAssets.Workflow}}
  # It verifies each asset's attestation, stages the assets on a draft, and publishes last.
{{- end}}
  publish:
    needs: [{{.Needs}}]
    if: >-
      !cancelled() && github.event_name != 'pull_request' && needs.validate.outputs.publish == 'true'
      && !contains(needs.*.result, 'failure') && !contains(needs.*.result, 'cancelled')
    runs-on: ubuntu-latest
    environment: release
    permissions:
      contents: write
      pull-requests: read # to confirm the merged pull request
      actions: read # to download the pull request's run's artifacts
{{- if .ReleaseAssets.Workflow}}
      attestations: read # to verify the assets' build attestations
{{- end}}
    # Serialize publication so competing releases cannot race.
    concurrency:
      group: release-publication
      cancel-in-progress: false
    steps:
{{- template "install" .}}
      - uses: {{.Actions.DownloadArtifact}}
        with:
          name: release-plan
          path: ${{"{{"}} runner.temp {{"}}"}}/plan
      # The run that checked and built the release: the pull request's, or this one.
      - uses: {{.Actions.DownloadArtifact}}
        if: needs.validate.outputs.tag != ''
        with:
          name: release-plan
          path: ${{"{{"}} runner.temp {{"}}"}}/built
          run-id: ${{"{{"}} needs.validate.outputs.build-run {{"}}"}}
          github-token: ${{"{{"}} github.token {{"}}"}}
{{- if .ReleaseAssets.Workflow}}
      - uses: {{.Actions.DownloadArtifact}}
        if: needs.validate.outputs.tag != ''
        with:
          name: release-assets
          path: ${{"{{"}} runner.temp {{"}}"}}/release-assets
          run-id: ${{"{{"}} needs.validate.outputs.build-run {{"}}"}}
          github-token: ${{"{{"}} github.token {{"}}"}}
{{- end}}
      - name: Publish the approved release
        env:
          GITHUB_TOKEN: ${{"{{"}} github.token {{"}}"}}
        run: release-planner publish --plan "$RUNNER_TEMP/plan/release-plan.json" --built-plan "$RUNNER_TEMP/built/release-plan.json" --branch {{.Branch}}{{if .ReleaseAssets.Workflow}} --assets "$RUNNER_TEMP/release-assets" --signer-workflow .github/workflows/release-planner.yml{{end}}
{{- if .ReleaseAssets.Workflow}}

  # Attest the published assets again, from the release branch. The attest job ran on the
  # pull request; this attestation exists only for files that were approved, verified, and
  # published, so downstream consumers can require one signed on {{.Branch}}. This job runs no
  # repository code.
  attest-release:
    needs: [validate, publish]
    if: needs.publish.result == 'success' && needs.validate.outputs.tag != ''
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
      attestations: write
    steps:
      - name: Download the published assets
        env:
          GH_TOKEN: ${{"{{"}} github.token {{"}}"}}
          TAG: ${{"{{"}} needs.validate.outputs.tag {{"}}"}}
        run: gh release download "$TAG" --repo "$GITHUB_REPOSITORY" --dir "$RUNNER_TEMP/published"
      - uses: {{.Actions.AttestBuildProvenance}}
        with:
          subject-path: '${{"{{"}} runner.temp {{"}}"}}/published/*'
{{- end}}
{{- if .Downstream}}

  # After a new stable release, run the workflows that depend on it in other repositories,
  # with a GitHub App token limited to them. Nothing here can change the release. One job
  # per target, so Re-run failed jobs runs only the targets that failed.
  downstream:
    name: downstream (${{"{{"}} matrix.target {{"}}"}})
    needs: [validate, publish{{if .ReleaseAssets.Workflow}}, attest-release{{end}}]
    if: needs.publish.result == 'success'{{if .ReleaseAssets.Workflow}} && needs.attest-release.result == 'success'{{end}} && needs.validate.outputs.tag != '' && !contains(needs.validate.outputs.version, '-')
    strategy:
      fail-fast: false
      matrix:
        target: [{{range $i, $d := .Downstream}}{{if $i}}, {{end}}{{yamlString (printf "%s:%s" $d.Repository $d.Workflow)}}{{end}}]
    runs-on: ubuntu-latest
    environment: downstream
    permissions:
      contents: read
    steps:
      - name: Check the downstream GitHub App settings
        env:
          CLIENT_ID: ${{"{{"}} vars.DOWNSTREAM_APP_CLIENT_ID {{"}}"}}
          HAS_KEY: ${{"{{"}} secrets.DOWNSTREAM_APP_PRIVATE_KEY != '' {{"}}"}}
        run: |
          if [ -z "$CLIENT_ID" ] || [ "$HAS_KEY" != true ]; then
            echo "::error title=Downstream::Set the DOWNSTREAM_APP_CLIENT_ID variable and the DOWNSTREAM_APP_PRIVATE_KEY secret in the downstream environment: {{.DownstreamDocs}}"
            exit 1
          fi
      - uses: {{.Actions.CreateGitHubAppToken}}
        id: token
        with:
          client-id: ${{"{{"}} vars.DOWNSTREAM_APP_CLIENT_ID {{"}}"}}
          private-key: ${{"{{"}} secrets.DOWNSTREAM_APP_PRIVATE_KEY {{"}}"}}
          owner: {{yamlString .DownstreamOwner}}
          repositories: {{yamlString (join .DownstreamRepositories ",")}}
          permission-actions: write
{{- template "install" .}}
      - name: Run the downstream workflow
        env:
          GITHUB_TOKEN: ${{"{{"}} steps.token.outputs.token {{"}}"}}
          TAG: ${{"{{"}} needs.validate.outputs.tag {{"}}"}}
          TARGET: ${{"{{"}} matrix.target {{"}}"}}
        run: release-planner downstream --tag "$TAG" --target "$TARGET"
{{- end}}

  # Keep the summary at the start of the release pull request's description and the status at
  # its end up to date, from its checks through publication, whatever failed. After the merge, a
  # failure also gets a comment that mentions whoever merged, since editing a description
  # notifies no one.
  report:
    needs: [{{.Needs}}, publish{{if .ReleaseAssets.Workflow}}, attest-release{{end}}{{if .Downstream}}, downstream{{end}}]
    if: always() && needs.validate.result != 'skipped'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      actions: read # to download and link the build run's assets and link each job{{if .Downstream}} and read each downstream job's result{{end}}
      pull-requests: write # to edit the description's release status and comment on a failure
    steps:
{{- template "install" .}}
      # Missing when validation failed; the report says which job did.
      - uses: {{.Actions.DownloadArtifact}}
        continue-on-error: true
        with:
          name: release-plan
          path: ${{"{{"}} runner.temp {{"}}"}}/plan
{{- if .ReleaseAssets.Workflow}}
      - uses: {{.Actions.DownloadArtifact}}
        if: needs.validate.outputs.tag != ''
        continue-on-error: true
        with:
          name: release-assets
          path: ${{"{{"}} runner.temp {{"}}"}}/release-assets
          run-id: ${{"{{"}} needs.validate.outputs.build-run {{"}}"}}
          github-token: ${{"{{"}} github.token {{"}}"}}
{{- end}}
      - name: Report the release status
        env:
          GITHUB_TOKEN: ${{"{{"}} github.token {{"}}"}}
          NEEDS: ${{"{{"}} toJSON(needs) {{"}}"}}
          PULL_REQUEST: ${{"{{"}} github.event.pull_request.number {{"}}"}}
          HEAD_SHA: ${{"{{"}} github.event.pull_request.head.sha {{"}}"}}
          HEAD_REF: ${{"{{"}} github.event.pull_request.head.ref {{"}}"}}
          HEAD_REPOSITORY: ${{"{{"}} github.event.pull_request.head.repo.full_name {{"}}"}}
          MERGED: ${{"{{"}} inputs.merged-commit || github.sha {{"}}"}}
        run: |
          if [ -n "$PULL_REQUEST" ]; then target=(--pull-request "$PULL_REQUEST" --head-sha "$HEAD_SHA" --head-ref "$HEAD_REF" --head-repository "$HEAD_REPOSITORY"); else target=(--merged "$MERGED"); fi
          release-planner report --needs "$NEEDS" --branch {{.Branch}} --plan "$RUNNER_TEMP/plan/release-plan.json"{{if .ReleaseAssets.Workflow}} --assets "$RUNNER_TEMP/release-assets"{{end}}{{range .Downstream}} --downstream {{.Repository}}:{{.Workflow}}{{end}} "${target[@]}"
