# Release Planner configuration: https://github.com/fabricahq/release-planner#configuration

# The format of this file.
schema-version: 1

# The Release Planner version to use. Bumping it upgrades the GitHub Actions workflow
# (.github/workflows/release-planner.yml) and the agent guide together; run
# release-planner install after changing it.
version: {{.Version}}

# The version your first release must use.
first-version: {{.FirstVersion}}

# Optional release-only checks, run on the exact commit being released, before it is
# tagged. Your required pull request checks already test what merges, so use this only for
# checks they don't run: a smoke test of what you ship, an API compatibility check against
# the previous release, a fresh vulnerability scan, or a slow end-to-end suite.
#
# Either a Bash script, with optional go, node, and python toolchains:
# release-checks:
#   go: '1.27.x'
#   run: |
#     go install golang.org/x/vuln/cmd/govulncheck@latest
#     govulncheck ./...
#
# Or one of your workflows, called with the commit to check and your repository's secrets.
# It needs a workflow_call trigger with a string input named ref, and must check out that ref:
# release-checks:
#   workflow: release-checks.yml

# Release notes rules to skip. release-planner validate checks the notes against every rule;
# list them with: release-planner validate --rules
# exclude-rules: [no-long-heading]

# Your own release notes style, if you want one: a markdown file, and how it combines with
# Release Planner's default style. append adds yours after the default; replace uses only yours.
# Print the default style with: release-planner guide --default-style
# release-notes-style:
#   file: .release-planner/release-notes-style.md
#   mode: append

# Where release notes live, and the branch whose notes changes publish releases.
# notes-dir: _releases
# branch: main
